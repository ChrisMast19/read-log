# Local dev only. Copy this file to ".env" and fill in your key, then run `netlify dev`.
# In PRODUCTION, do NOT use this file — set these in the Netlify dashboard:
#   Site settings -> Environment variables
# Never commit a real key.

CLAUDE_API_KEY=sk-ant-your-key-here

# Optional. Defaults to claude-sonnet-5 if unset.
CLAUDE_MODEL=claude-sonnet-5
